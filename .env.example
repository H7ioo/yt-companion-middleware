# YouTube OAuth 2.0 credentials (Google Cloud Console -> OAuth client)
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret

# Refresh token obtained once via the OAuth consent flow.
# Stored server-side only; never exposed to Companion or any client.
YT_REFRESH_TOKEN=your-refresh-token

# HTTP server
PORT=8080

# Directory for the JSON store (mounted as a Docker volume in production)
DATA_DIR=./data

# Seconds between background state-cache refreshes
REFRESH_INTERVAL_SECONDS=60

# Consecutive refresh failures before health escalates ok -> degraded -> auth_error
HEALTH_FAILURE_THRESHOLD=3

# Region (ISO 3166-1 alpha-2) used to fetch the assignable video-category list
YT_REGION_CODE=US

# Daily YouTube Data API quota budget in cost-weighted units (reads=1, writes=50).
# Default project quota is 10,000/day; surfaced on the dashboard + /api/feedback/health.
YT_QUOTA_LIMIT=10000

# ---- Public origin (hosted deployments only) -------------------------------
# The full origin this server answers on, scheme included and with no trailing path. Setting it
# turns on browser sign-in for YouTube: the dashboard sends the admin's own browser to Google and
# Google returns it to this origin's callback, so nobody has to run scripts/get-refresh-token.mjs
# or paste a refresh token by hand.
#
# Register this exact string as an Authorized redirect URI on the OAuth client:
#
#     <PUBLIC_ORIGIN>/api/setup/oauth/callback
#
# It is matched character for character. A wrong value does not fail at boot — it fails at the
# consent screen with redirect_uri_mismatch. The dashboard shows the string to copy.
#
# Leave unset for desktop, LAN and direct-Docker installs, where credentials are entered by hand.
# PUBLIC_ORIGIN=https://live.example.org

# ---- Accounts (hosted deployments only) ------------------------------------
# Setting BOTH of these seeds an admin account at boot and turns authentication on: the dashboard
# gains a login screen and /api/dashboard/settings starts requiring a session.
#
# Leave them unset for a desktop or LAN install. With no accounts the deployment has no login
# screen and nothing is guarded — exactly as it behaves today. There is deliberately no "claim this
# deployment" page: a public host with an open setup screen belongs to whoever finds it first.
#
# The password must be at least 12 characters; the server refuses to boot with a weaker one. It is
# used only to create the account on first boot — changing it here later does not overwrite a
# password the admin has since changed.
# ADMIN_USERNAME=operator
# ADMIN_PASSWORD=
#
# Set both or neither — half a seed is a boot failure, not a server with no accounts.

# Trust X-Forwarded-For / X-Forwarded-Proto from the hop in front (express's `trust proxy`).
# Leave unset unless a proxy you control is the only way to reach this server: when nothing is in
# front, those headers are whatever the caller typed, and honouring them hands every sign-in
# attempt a fresh throttle key. Use a hop count behind Cloudflare/nginx (TRUST_PROXY=1); `true`,
# `loopback`, or a comma-separated address list also work.
# TRUST_PROXY=1
